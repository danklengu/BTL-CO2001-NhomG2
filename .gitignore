# ==============================================================================
# LATEX BUILD ARTIFACTS TO IGNORE
# ==============================================================================

# Auxiliary files generated by pdflatex / xelatex / lualatex
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)

# Bibliography build artifacts
*.bbl
*.blg
*.bcf
*.run.xml

# Glossaries and index build artifacts
*.acn
*.glo
*.ist
*.alg
*.gls

# Temporary/Backup files
*~
*.bak
*.sav
.DS_Store
Thumbs.db

# Ignore all generated PDF build files EXCEPT the official report file on main
*.pdf
!Bao_Cao_BTL_CO2001_NhomG2.pdf
